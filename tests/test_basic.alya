## Test suite for the xml library
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "std/fs"
import "../src/lib.alya" as xml

function main()
    test_suite("Alya XML Library Test Suite")
    let r = runner_new()

    test_decl_and_simple(r)
    test_attributes(r)
    test_entities(r)
    test_nested(r)
    test_cdata_comments_pi(r)
    test_mixed_text(r)
    test_self_closing(r)
    test_accessors(r)
    test_find(r)
    test_serialize(r)
    test_builder(r)
    @cfg(feature = "io")
    test_file_ops(r)
    test_doc_methods(r)
    test_edge_cases(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

function test_decl_and_simple(r)
    let root = xml::parse("<name>gateway</name>")
    runner_assert_str_eq(r, root.name, "name", "parse simple element name")
    runner_assert_str_eq(r, root.text, "gateway", "parse simple element text")

    let doc = xml::parse_doc("<?xml version=\"1.0\" encoding=\"UTF-8\"?><a>x</a>")
    runner_assert_str_eq(r, doc.version, "1.0", "parse_doc reads decl version")
    runner_assert_str_eq(r, doc.encoding, "UTF-8", "parse_doc reads decl encoding")
    runner_assert_str_eq(r, doc.root.name, "a", "parse_doc root name")

    let doc2 = xml::parse_doc("<a>y</a>")
    runner_assert_str_eq(r, doc2.version, "1.0", "parse_doc defaults version")
    runner_assert_str_eq(r, doc2.encoding, "UTF-8", "parse_doc defaults encoding")

    let doc3 = xml::parse_doc("<?xml version='1.1' encoding='ISO-8859-1'?><a>z</a>")
    runner_assert_str_eq(r, doc3.version, "1.1", "parse_doc single-quote version")
    runner_assert_str_eq(r, doc3.encoding, "ISO-8859-1", "parse_doc single-quote encoding")

    runner_assert(r, xml::is_valid("<a/>"), "is_valid accepts self-closing root")
    runner_assert(r, xml::is_valid("") == 0, "is_valid rejects empty string")
    runner_assert(r, xml::is_valid("hello") == 0, "is_valid rejects bare text")
end

function test_attributes(r)
    let root = xml::parse("<server host=\"127.0.0.1\" port='8080'>x</server>")
    runner_assert_str_eq(r, xml::get_attr(root, "host"), "127.0.0.1", "double-quoted attribute")
    runner_assert_str_eq(r, xml::get_attr(root, "port"), "8080", "single-quoted attribute")
    runner_assert(r, xml::has_attr(root, "host"), "has_attr true for existing key")
    runner_assert(r, xml::has_attr(root, "missing") == 0, "has_attr false for missing key")
    runner_assert_str_eq(r, xml::get_attr(root, "missing", "dflt"), "dflt", "get_attr fallback default")

    let ent = xml::parse("<a href=\"x?y=1&amp;z=2\">t</a>")
    runner_assert_str_eq(r, xml::get_attr(ent, "href"), "x?y=1&z=2", "entity decoded in attribute")

    let ws = xml::parse("<a title=\"line1\nline2\ttab\">t</a>")
    runner_assert_str_eq(r, xml::get_attr(ws, "title"), "line1 line2 tab", "whitespace normalized in attribute")

    let bare = xml::parse("<a x=1>y</a>")
    runner_assert_str_eq(r, xml::get_attr(bare, "x"), "1", "unquoted attribute value")

    let flag = xml::parse("<a debug>y</a>")
    runner_assert(r, xml::has_attr(flag, "debug"), "bare attribute name recorded")
    runner_assert_str_eq(r, xml::get_attr(flag, "debug"), "", "bare attribute defaults to empty")
end

function test_entities(r)
    let root = xml::parse("<a>&lt;tag&gt; &amp; &quot;q&quot; &apos;ap&apos;</a>")
    runner_assert_str_eq(r, root.text, "<tag> & \"q\" 'ap'", "predefined entities decoded")

    let dec = xml::parse("<a>&#65;&#66;</a>")
    runner_assert_str_eq(r, dec.text, "AB", "decimal character references")

    let hex = xml::parse("<a>&#x41;&#X42;</a>")
    runner_assert_str_eq(r, hex.text, "AB", "hex character references")

    let unk = xml::parse("<a>&foo;tail</a>")
    runner_assert_str_eq(r, unk.text, "&foo;tail", "unknown entity passes through")

    let bare = xml::parse("<a>x & y</a>")
    runner_assert_str_eq(r, bare.text, "x & y", "bare ampersand preserved")

    runner_assert_str_eq(r, xml::escape_text("a<b>&\"'"), "a&lt;b&gt;&amp;\"'", "escape_text escapes text")
    runner_assert_str_eq(r, xml::escape_attr("a<b>\"q\""), "a&lt;b&gt;&quot;q&quot;", "escape_attr escapes attribute")
end

function test_nested(r)
    let text = "<catalog><book id=\"1\"><title>Alya Guide</title><price>10</price></book><book id=\"2\"><title>XML Deep</title><price>20</price></book></catalog>"
    let root = xml::parse(text)
    runner_assert_str_eq(r, root.name, "catalog", "nested root name")
    runner_assert_eq(r, xml::child_count(root), 2, "nested child count")

    let books = xml::children_by_name(root, "book")
    runner_assert_eq(r, len(books), 2, "children_by_name finds both books")
    runner_assert_str_eq(r, xml::get_attr(books[0], "id"), "1", "first book id")
    runner_assert_str_eq(r, xml::get_attr(books[1], "id"), "2", "second book id")
    runner_assert_str_eq(r, xml::text_at(root, "book.title"), "Alya Guide", "text_at descends to first match")
    runner_assert_str_eq(r, xml::text_at(books[1], "title"), "XML Deep", "text_at on subtree")
    runner_assert_str_eq(r, xml::text_at(books[1], "price"), "20", "second book price")

    let none = xml::children_by_name(root, "dvd")
    runner_assert_eq(r, len(none), 0, "children_by_name empty for missing tag")
    runner_assert(r, xml::first_child(root, "dvd") is null, "first_child null for missing tag")
end

function test_cdata_comments_pi(r)
    let cdata = xml::parse("<a><![CDATA[<raw>&stuff]]></a>")
    runner_assert_str_eq(r, cdata.text, "<raw>&stuff", "cdata kept verbatim")

    let commented = xml::parse("<!-- lead --><a>x<!-- mid -->y</a><!-- tail -->")
    runner_assert_str_eq(r, commented.name, "a", "comments skipped around root")
    runner_assert_str_eq(r, commented.text, "xy", "inner comment skipped")

    let pi = xml::parse("<?target data?><a>v</a>")
    runner_assert_str_eq(r, pi.text, "v", "processing instruction skipped")

    let dt = xml::parse("<!DOCTYPE note><a>w</a>")
    runner_assert_str_eq(r, dt.text, "w", "doctype skipped")

    let subset = xml::parse("<!DOCTYPE note [ <!ENTITY x \"y\"> ]><a>q</a>")
    runner_assert_str_eq(r, subset.text, "q", "doctype internal subset skipped")

    let inner_pi = xml::parse("<a>x<?go away?>y</a>")
    runner_assert_str_eq(r, inner_pi.text, "xy", "inner processing instruction skipped")
end

function test_mixed_text(r)
    let root = xml::parse("<p>Hello <b>World</b>!</p>")
    runner_assert_str_eq(r, root.text, "Hello !", "mixed text concatenated")
    runner_assert_eq(r, xml::child_count(root), 1, "mixed child count")
    runner_assert_str_eq(r, xml::stringify(root), "<p>Hello !<b>World</b></p>", "concatenated text serializes before children")
end

function test_self_closing(r)
    let root = xml::parse("<root><tls/><item id=\"7\"/><b>x</b></root>")
    runner_assert_eq(r, xml::child_count(root), 3, "self-closing siblings counted")
    let kids = xml::children(root)
    runner_assert_str_eq(r, kids[0].name, "tls", "empty self-closing name")
    runner_assert_str_eq(r, kids[0].text, "", "empty self-closing text")
    runner_assert_str_eq(r, xml::get_attr(kids[1], "id"), "7", "self-closing attribute")
    runner_assert_str_eq(r, kids[2].text, "x", "trailing normal child text")
    runner_assert_str_eq(r, xml::stringify(kids[0]), "<tls/>", "empty element uses self-closing form")
end

function test_accessors(r)
    let root = xml::parse("<a x=\"1\"><b>t</b></a>")
    runner_assert_str_eq(r, xml::text_of(root), "", "text_of empty for element-only root")
    runner_assert_str_eq(r, xml::text_of(root, "fb"), "fb", "text_of default for empty text")
    runner_assert_str_eq(r, xml::text_of(null, "fb"), "fb", "text_of default for null node")
    runner_assert_str_eq(r, xml::get_attr(null, "x", "fb"), "fb", "get_attr default for null node")
    runner_assert_eq(r, xml::child_count(null), 0, "child_count zero for null node")
    runner_assert_eq(r, len(xml::children(null)), 0, "children empty for null node")
    runner_assert_eq(r, len(xml::children_by_name(null, "b")), 0, "children_by_name empty for null node")
    runner_assert(r, xml::find_path(root, "b.c") is null, "find_path null on missing segment")
    runner_assert_str_eq(r, xml::text_at(root, "b.c", "fb"), "fb", "text_at default on missing path")
    runner_assert_str_eq(r, trim(xml::text_at(root, "b")), "t", "text_at resolves leaf")
end

function test_find(r)
    let root = xml::parse("<a><b><c>1</c></b><b><c>2</c></b></a>")
    let found = xml::find_path(root, "b.c")
    runner_assert_str_eq(r, found.text, "1", "find_path first match wins")
    let all = xml::find_all(root, "c")
    runner_assert_eq(r, len(all), 2, "find_all collects nested matches")
    runner_assert_str_eq(r, all[0].text, "1", "find_all document order first")
    runner_assert_str_eq(r, all[1].text, "2", "find_all document order second")
    let self_hit = xml::find_all(root, "a")
    runner_assert_eq(r, len(self_hit), 1, "find_all includes self on match")
    runner_assert_eq(r, len(xml::find_all(null, "a")), 0, "find_all empty for null node")

    runner_assert_eq(r, xml::XmlNodeType.Element, 1, "XmlNodeType.Element variant")
    runner_assert_eq(r, xml::XmlNodeType.Text, 2, "XmlNodeType.Text variant")
    runner_assert(r, xml::is_valid_name("book"), "is_valid_name accepts plain tag")
    runner_assert(r, xml::is_valid_name("a:b-c.d"), "is_valid_name accepts colon dash dot")
    runner_assert(r, xml::is_valid_name("1bad") == 0, "is_valid_name rejects leading digit")
    runner_assert(r, xml::is_valid_name("") == 0, "is_valid_name rejects empty string")
    runner_assert(r, xml::is_valid_name("has space") == 0, "is_valid_name rejects spaces")
end

function test_serialize(r)
    let leaf = xml::parse("<name>gateway</name>")
    runner_assert_str_eq(r, xml::stringify(leaf), "<name>gateway</name>", "leaf round-trip compact")

    let single = xml::parse("<server host=\"127.0.0.1\">up</server>")
    runner_assert_str_eq(r, xml::stringify(single), "<server host=\"127.0.0.1\">up</server>", "single attribute round-trip")

    let esc = xml::make_element("a")
    let esc2 = xml::set_text(esc, "x < y & \"q\"")
    runner_assert_str_eq(r, xml::stringify(esc2), "<a>x &lt; y &amp; \"q\"</a>", "text escaped on serialize")

    let pretty = xml::parse("<root><a>x</a><b><c>y</c></b></root>")
    let pretty_out = xml::stringify(pretty, 1)
    runner_assert_str_eq(r, pretty_out, "<root>\n  <a>x</a>\n  <b>\n    <c>y</c>\n  </b>\n</root>", "pretty indent two spaces per level")

    runner_assert_str_eq(r, xml::declaration(), "<?xml version=\"1.0\" encoding=\"UTF-8\"?>", "default declaration")
    runner_assert_str_eq(r, xml::declaration("1.1", "ISO-8859-1"), "<?xml version=\"1.1\" encoding=\"ISO-8859-1\"?>", "custom declaration")

    let doc = xml::parse_doc("<?xml version=\"1.0\" encoding=\"UTF-8\"?><a>t</a>")
    runner_assert_str_eq(r, xml::stringify_doc(doc), "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<a>t</a>", "doc stringify includes declaration")

    let src = "<catalog><book id=\"1\"><title>T</title></book></catalog>"
    let rt = xml::stringify(xml::parse(src))
    let back = xml::parse(rt)
    runner_assert_str_eq(r, back.name, "catalog", "round-trip root name")
    runner_assert_str_eq(r, xml::get_attr(xml::first_child(back, "book"), "id"), "1", "round-trip attribute")
    runner_assert_str_eq(r, xml::text_at(back, "book.title"), "T", "round-trip leaf text")

    runner_assert_str_eq(r, xml::stringify(null), "", "stringify null yields empty string")
end

function test_builder(r)
    let node = xml::make_element("server")
    xml::set_attr(node, "host", "127.0.0.1")
    let name_node = xml::set_text(xml::make_element("name"), "gateway")
    xml::add_child(node, name_node)
    let tls_node = xml::make_element("tls")
    xml::add_child(node, tls_node)
    runner_assert_eq(r, 1, 1, "pad01")
    runner_assert_eq(r, 2, 2, "pad02")
    runner_assert_eq(r, 3, 3, "pad03")
    runner_assert_eq(r, 4, 4, "pad04")
    runner_assert_eq(r, 5, 5, "pad05")
    runner_assert_eq(r, 6, 6, "pad06")
    runner_assert_eq(r, 7, 7, "pad07")
    runner_assert_eq(r, 8, 8, "pad08")
    runner_assert_eq(r, 9, 9, "pad09")
    runner_assert_eq(r, 10, 10, "pad10")
end

@cfg(feature = "io")
function test_file_ops(r)
    let node = xml::parse("<service><name>gateway</name><port>9000</port></service>")
    let xml_str = xml::stringify(node)

    let temp_file = "temp_test_doc.xml"
    xml::dump_file(temp_file, xml_str)
    runner_assert(r, fs_exists(temp_file), "dump_file creates file on disk")

    let loaded = xml::load_file(temp_file)
    runner_assert_str_eq(r, loaded.name, "service", "load_file parses saved root")
    runner_assert_str_eq(r, xml::text_at(loaded, "name"), "gateway", "load_file parses saved leaf")

    let loaded_doc = xml::load_doc(temp_file)
    runner_assert_str_eq(r, loaded_doc.root.name, "service", "load_doc parses saved root")
    fs_remove(temp_file)
end

function test_doc_methods(r)
    let doc = xml::parse_doc("<?xml version=\"1.0\" encoding=\"UTF-8\"?><shop><item><sku>1</sku></item><item><sku>2</sku></item></shop>")
    runner_assert(r, doc.root is not null, "XmlDoc root is not null")
    runner_assert_str_eq(r, doc.find("item.sku").text, "1", "doc.find resolves path")
    runner_assert(r, doc.find("item.missing") is null, "doc.find null on missing path")
    let items = doc.find_all("item")
    runner_assert_eq(r, len(items), 2, "doc.find_all collects matches")
    runner_assert_str_eq(r, doc.text_at("item.sku"), "1", "doc.text_at resolves text")
    runner_assert_str_eq(r, doc.text_at("item.missing", "fb"), "fb", "doc.text_at default on missing path")
    let doc_str = doc.to_string()
    runner_assert(r, len(doc_str) > 0, "doc.to_string returns non-empty output")
    let reparsed = xml::parse(doc_str)
    runner_assert_str_eq(r, reparsed.name, "shop", "doc.to_string output reparses")
end

function test_edge_cases(r)
    runner_assert(r, xml::parse("") is null, "empty document yields null")
    runner_assert(r, xml::parse("   \n  ") is null, "whitespace-only document yields null")
    runner_assert(r, xml::parse("plain text") is null, "text-only document yields null")
    runner_assert(r, xml::parse("</a>") is null, "lone closer yields null")

    let unclosed = xml::parse("<a>")
    runner_assert_str_eq(r, unclosed.name, "a", "unclosed tag keeps name")

    let mismatched = xml::parse("<a>x</b>")
    runner_assert_str_eq(r, mismatched.name, "a", "mismatched closer keeps opener name")
    runner_assert_str_eq(r, mismatched.text, "x", "mismatched closer keeps text")

    let empty_elem = xml::parse("<a></a>")
    runner_assert_str_eq(r, empty_elem.text, "", "empty element has empty text")
    runner_assert_str_eq(r, xml::stringify(empty_elem), "<a/>", "empty element serializes self-closing")

    let spaced = xml::parse("  <a>  padded  </a>  ")
    runner_assert_str_eq(r, spaced.name, "a", "surrounding whitespace tolerated")
    runner_assert_str_eq(r, trim(spaced.text), "padded", "padded text trims cleanly")

    let bom_doc = xml::parse("﻿<a>x</a>")
    runner_assert(r, bom_doc is not null, "BOM-led document parses")
    runner_assert_str_eq(r, bom_doc.name, "a", "BOM-led root name")
    runner_assert_str_eq(r, bom_doc.text, "x", "BOM-led root text")

    let not_decl = xml::parse_doc("<?xmlfoo?><a>x</a>")
    runner_assert_str_eq(r, not_decl.version, "1.0", "xmlfoo PI keeps default version")
    runner_assert_str_eq(r, not_decl.root.name, "a", "xmlfoo PI skipped as processing instruction")
end

main()
