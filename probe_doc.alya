import "std/test"
import "./src/lib.alya" as xml

function main()
    let r = runner_new()
    let i = 0
    while i < 2000
        let d = xml::parse("<a x=\"1\"><b>t</b></a>")
        let s = xml::stringify(d)
        i += 1
    end
    say "pressure done"
    let doc = xml::parse_doc("<?xml version=\"1.0\" encoding=\"UTF-8\"?><shop><item><sku>1</sku></item><item><sku>2</sku></item></shop>")
    let items = doc.find_all("item")
    runner_assert_eq(r, len(items), 2, "findall")
    say doc.text_at("item.sku")
    say "doc done"
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
