## # xml/serializer
##
## XML value escaping, element serialization, and builder helpers.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Serializes `XmlNode` trees back to XML text in compact or indented
## (pretty) form, and offers builder helpers for programmatic documents.

import "./types.alya"

## Escapes text content (`&`, `<`, `>`).
##
## ### Parameters
## - `s`: Raw text value (null yields `""`).
##
## ### Returns
## The escaped XML text string.
pub function escape_text(s: string) -> string
    if s is null
        return ""
    end
    let res = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        let e = when ch
            is "&" => "&amp;"
            is "<" => "&lt;"
            is ">" => "&gt;"
            else => ch
        end
        res += e
        i += 1
    end
    return res
end

## Escapes an attribute value (`&`, `<`, `"`, plus whitespace controls).
##
## Tab, LF, and CR are emitted as character references so a parse round-trip
## preserves them instead of normalizing them to spaces.
##
## ### Parameters
## - `s`: Raw attribute value (null yields `""`).
##
## ### Returns
## The escaped XML attribute string.
pub function escape_attr(s: string) -> string
    if s is null
        return ""
    end
    let res = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        let e = when ch
            is "&" => "&amp;"
            is "<" => "&lt;"
            is ">" => "&gt;"
            is "\"" => "&quot;"
            is "\t" => "&#9;"
            is "\n" => "&#10;"
            is "\r" => "&#13;"
            else => ch
        end
        res += e
        i += 1
    end
    return res
end

## Checks whether a string is a valid XML name.
##
## Requires a non-empty string starting with a name-start character
## followed by name characters (ASCII subset of the XML 1.0 production).
##
## ### Parameters
## - `name`: Candidate tag or attribute name (or null).
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function is_valid_name(name: string) -> bool
    if name is null or len(name) == 0
        return false
    end
    if is_name_start_char(char_at(name, 0)) == false
        return false
    end
    let i = 1
    let n = len(name)
    while i < n
        if is_name_char(char_at(name, i)) == false
            return false
        end
        i += 1
    end
    return true
end

## Renders indentation padding (two spaces per level).
##
## ### Parameters
## - `level`: Nesting depth.
##
## ### Returns
## The padding string.
function indent_pad(level: int) -> string
    let res = ""
    let i = 0
    while i < level
        res += "  "
        i += 1
    end
    return res
end

## Reads one attribute value through a call boundary.
##
## Direct inline indexing (`node.attrs[key]`) inside attribute loops
## miscompiles to array indexing on some paths; routing the same read
## through this helper keeps map dispatch. Remove if the compiler fixes
## inline struct-field map reads with computed keys.
function attr_lookup(node, key: string) -> string
    return node.attrs[key]
end

## Renders an attribute map to ` key="value"` fragments.
##
## Attributes listed in the node's `attr_order` render first in document
## order; any other entries (e.g. set by direct map assignment) follow
## in map order.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
##
## ### Returns
## The concatenated attribute string (empty when no attributes).
function render_attrs(node) -> string
    if node is null or node.attrs is null
        return ""
    end
    let res = ""
    let seen = map()
    if node.attr_order is not null
        for aname in node.attr_order
            if _map_has(node.attrs, aname) == true
                let aval = escape_attr(attr_lookup(node, aname))
                res += f" {aname}=\"{aval}\""
                seen[aname] = true
            end
        end
    end
    let names = keys(node.attrs)
    for aname in names
        if _map_has(seen, aname) == false
            let aval = escape_attr(attr_lookup(node, aname))
            res += f" {aname}=\"{aval}\""
        end
    end
    return res
end

## Renders one node (and its subtree) to XML text.
##
## Empty elements use the self-closing form. In pretty mode, child elements
## go on their own lines while leaf text stays inline with its tags.
##
## ### Parameters
## - `node`: Target `XmlNode`.
## - `pretty`: `1` for indented output, `0` for compact output.
## - `level`: Current nesting depth.
##
## ### Returns
## The rendered XML string.
function render_node(node, pretty: int, level: int) -> string
    if node is null
        return ""
    end
    let n = node.name is null ? "" : node.name
    let astr = render_attrs(node)
    let kids = node.children is null ? [] : node.children
    let txt = node.text is null ? "" : node.text
    let kid_count = len(kids)
    let has_text = len(txt)
    if kid_count == 0 and has_text == 0
        if pretty == true
            let pad = indent_pad(level)
            return f"{pad}<{n}{astr}/>"
        end
        return f"<{n}{astr}/>"
    end
    if kid_count == 0
        let etext = escape_text(txt)
        if pretty == true
            let pad = indent_pad(level)
            return f"{pad}<{n}{astr}>{etext}</{n}>"
        end
        return f"<{n}{astr}>{etext}</{n}>"
    end
    if pretty == true
        let pad = indent_pad(level)
        let res = f"{pad}<{n}{astr}>"
        let t = trim(txt)
        if len(t) > 0
            res += escape_text(t)
        end
        let i = 0
        while i < kid_count
            res += "\n" + render_node(kids[i], pretty, level + 1)
            i += 1
        end
        res += f"\n{pad}</{n}>"
        return res
    end
    let res = f"<{n}{astr}>"
    res += escape_text(txt)
    let k = 0
    while k < kid_count
        res += render_node(kids[k], pretty, level + 1)
        k += 1
    end
    res += f"</{n}>"
    return res
end

## Serializes a node tree to an XML string.
##
## Element text is concatenated across children at parse time and renders
## before child elements (document order inside mixed content is not
## preserved by design).
##
## ### Parameters
## - `node`: Root `XmlNode` (null yields `""`).
## - `pretty`: `1` for indented output, `0` for compact output. Defaults to `0`.
##
## ### Returns
## The XML document string.
pub function node_to_string(node, pretty: int = 0) -> string
    if node is null
        return ""
    end
    return render_node(node, pretty, 0)
end

## Builds an XML declaration string.
##
## ### Parameters
## - `version`: XML version string. Defaults to `"1.0"`.
## - `encoding`: Encoding label string. Defaults to `"UTF-8"`.
##
## ### Returns
## The `<?xml ... ?>` declaration string.
pub function declaration(version: string = "1.0", encoding: string = "UTF-8") -> string
    return f"<?xml version=\"{version}\" encoding=\"{encoding}\"?>"
end

## Serializes a document (declaration plus root) to an XML string.
##
## ### Parameters
## - `doc`: Target `XmlDoc`.
## - `pretty`: `1` for indented output, `0` for compact output. Defaults to `0`.
##
## ### Returns
## The XML document string including the declaration line.
pub function doc_to_string(doc: XmlDoc, pretty: int = 0) -> string
    let decl = declaration(doc.version, doc.encoding)
    if doc.root is null
        return decl
    end
    let body = render_node(doc.root, pretty, 0)
    return f"{decl}\n{body}"
end

# ───────────────────────────────────────────────────────────────
# XML Builder API
# ───────────────────────────────────────────────────────────────

## Sets an attribute on a node, returning the node for chaining.
##
## ### Parameters
## - `node`: Target `XmlNode`.
## - `key`: Attribute name string.
## - `val`: Attribute value string.
##
## ### Returns
## The updated node.
pub function set_attr(node, key: string, val: string)
    if node.attr_order is null
        node.attrs[key] = val
        return node
    end
    if _map_has(node.attrs, key) == false
        node.attr_order.push(key)
    end
    node.attrs[key] = val
    return node
end

## Appends a child element, returning the parent for chaining.
##
## ### Parameters
## - `node`: Parent `XmlNode`.
## - `child`: Child `XmlNode` to append.
##
## ### Returns
## The updated parent node.
pub function add_child(node, child)
    node.children.push(child)
    return node
end

## Returns a node copy with replaced text content.
##
## ### Parameters
## - `node`: Source `XmlNode`.
## - `text`: New text content string.
##
## ### Returns
## A new `XmlNode` sharing attributes and children with updated text.
pub function set_text(node, text: string)
    return XmlNode {
        name: node.name,
        attrs: node.attrs,
        children: node.children,
        text: text,
        attr_order: node.attr_order
    }
end
