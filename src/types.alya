## # xml/types
##
## XML 1.0 data types, node model, and character classifiers.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Defines the element node container, the document wrapper, factory
## constructors, and ASCII classifiers shared by the parser and serializer.

## XML node kind discriminators.
pub enum XmlNodeType
    Element = 1,
    Text = 2
end

## Element node container.
##
## Text content of mixed elements is concatenated into `text` in document
## order; child elements are kept separately in `children`.
##
## ### Fields
## - `name`: Tag name string (e.g. `"server"`).
## - `attrs`: Attribute map (e.g. `{"host": "127.0.0.1"}`).
## - `children`: Child `XmlNode` element array.
## - `text`: Concatenated character content with entities already decoded.
## - `attr_order`: Attribute names in first-seen document order, driving
##   serializer output. Built by the parser and `set_attr`; nodes made by
##   hand with a missing `attr_order` fall back to map order.
pub struct XmlNode
    name: string,
    attrs,
    children: array,
    text: string,
    attr_order: array
end

## Document container wrapping the root element plus declaration metadata.
##
## ### Fields
## - `root`: Root `XmlNode` (or null for empty documents).
## - `version`: XML version string (defaults to `"1.0"`).
## - `encoding`: Encoding label string (defaults to `"UTF-8"`).
pub struct XmlDoc
    root,
    version: string,
    encoding: string
end

## Factory constructor creating an element node.
##
## ### Parameters
## - `name`: Tag name string.
## - `attrs`: Attribute map (defaults to an empty map when null).
## - `children`: Child element array (defaults to `[]` when null).
## - `text`: Character content. Defaults to `""`.
##
## ### Returns
## The new `XmlNode` instance.
##
## ### Examples
## ```alya
## let node = make_element("server", {"host": "127.0.0.1"})
## ```
pub function make_element(name: string, attrs = null, children = null, text: string = "") -> XmlNode
    let a = attrs
    if a is null
        a = map()
    end
    let c = children
    if c is null
        c = []
    end
    let order = []
    let akeys = keys(a)
    for ak in akeys
        order.push(ak)
    end
    return XmlNode {
        name: name,
        attrs: a,
        children: c,
        text: text,
        attr_order: order
    }
end

## Factory constructor wrapping a root node into an `XmlDoc`.
##
## ### Parameters
## - `root`: Root `XmlNode` (or null for empty documents).
## - `version`: XML version string. Defaults to `"1.0"`.
## - `encoding`: Encoding label string. Defaults to `"UTF-8"`.
##
## ### Returns
## The new `XmlDoc` instance.
pub function make_doc(root = null, version: string = "1.0", encoding: string = "UTF-8") -> XmlDoc
    return XmlDoc {
        root: root,
        version: version,
        encoding: encoding
    }
end

## Checks whether a character is ASCII horizontal whitespace (space or tab).
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` when the character is a space or tab, `0` otherwise.
pub function is_space(ch: string) -> int
    if ch == " " or ch == "\t"
        return 1
    end
    return 0
end

## Checks whether a character is XML whitespace (space, tab, CR, or LF).
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` for whitespace, `0` otherwise.
pub function is_whitespace(ch: string) -> int
    if ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
        return 1
    end
    return 0
end

## Checks whether a character is a decimal digit (`0-9`).
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` when the character is a digit, `0` otherwise.
pub function is_digit(ch: string) -> int
    let c = ord(ch)
    return c >= 48 and c <= 57
end

## Checks whether a character is a hexadecimal digit.
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` when the character is a hex digit, `0` otherwise.
pub function is_hex_digit(ch: string) -> int
    let c = ord(ch)
    return (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
end

## Checks whether a character may start an XML name (`Letter | '_' | ':'`).
##
## ASCII subset of the XML 1.0 `NameStartChar` production.
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` when the character may start a name, `0` otherwise.
pub function is_name_start_char(ch: string) -> int
    let c = ord(ch)
    if (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
        return 1
    end
    if ch == "_" or ch == ":"
        return 1
    end
    return 0
end

## Checks whether a character may continue an XML name.
##
## ASCII subset of the XML 1.0 `NameChar` production: start characters
## plus digits, `-`, and `.`.
##
## ### Parameters
## - `ch`: Single-character string.
##
## ### Returns
## `1` when the character may appear in a name, `0` otherwise.
pub function is_name_char(ch: string) -> int
    if is_name_start_char(ch) == 1
        return 1
    end
    let c = ord(ch)
    if (c >= 48 and c <= 57) or ch == "-" or ch == "."
        return 1
    end
    return 0
end

## Checks whether a map contains a key using native membership.
##
## ### Parameters
## - `m`: Target map (or null).
## - `key`: Key string.
##
## ### Returns
## `1` when the key exists, `0` otherwise.
pub function _map_has(m, key: string) -> int
    if m is null
        return 0
    end
    return key in m ? 1 : 0
end
