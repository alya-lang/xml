## # xml/parser
##
## XML 1.0 document parser.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Parses declarations, comments, processing instructions, DOCTYPE blocks,
## CDATA sections, entity and character references, attributes, and nested
## elements into `XmlNode` trees. Malformed closers are tolerated leniently
## (the innermost open element is closed); use `is_valid_name` from the
## serializer to validate tag names when strictness is required.

import "./types.alya"

## Advances past XML whitespace (space, tab, CR, LF).
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Starting position.
## - `text_len`: Total text length.
##
## ### Returns
## The first non-whitespace position.
pub function skip_ws(text: string, pos: int, text_len: int) -> int
    while pos < text_len
        if is_whitespace(char_at(text, pos)) == true
            pos += 1
        else
            break
        end
    end
    return pos
end

## Skips a `<!-- ... -->` comment, returning the position past `-->`.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `<` (the `<!--` opener must be verified by the caller).
## - `text_len`: Total text length.
##
## ### Returns
## The position past the comment (or end of input when unterminated).
pub function skip_comment(text: string, pos: int, text_len: int) -> int
    pos += 4
    while pos < text_len
        if pos + 2 < text_len and substring(text, pos, 3) == "-->"
            return pos + 3
        end
        pos += 1
    end
    return pos
end

## Skips a `<? ... ?>` processing instruction.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `<` (the `<?` opener must be verified by the caller).
## - `text_len`: Total text length.
##
## ### Returns
## The position past `?>` (or end of input when unterminated).
pub function skip_pi(text: string, pos: int, text_len: int) -> int
    pos += 2
    while pos < text_len
        if pos + 1 < text_len and substring(text, pos, 2) == "?>"
            return pos + 2
        end
        pos += 1
    end
    return pos
end

## Skips a `<!...>` markup declaration (DOCTYPE, ENTITY, etc.).
##
## Tracks `[...]` internal-subset depth and quoted strings so a `>` inside
## the internal subset does not end the declaration early.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `<` (the `<!` opener must be verified by the caller).
## - `text_len`: Total text length.
##
## ### Returns
## The position past the closing `>` (or end of input when unterminated).
pub function skip_bang(text: string, pos: int, text_len: int) -> int
    pos += 2
    let depth = 0
    let quote = ""
    while pos < text_len
        let ch = char_at(text, pos)
        if quote != ""
            if ch == quote
                quote = ""
            end
        elif ch == "\"" or ch == "'"
            quote = ch
        elif ch == "["
            depth += 1
        elif ch == "]"
            if depth > 0
                depth -= 1
            end
        elif ch == ">" and depth == 0
            return pos + 1
        end
        pos += 1
    end
    return pos
end

## Advances past whitespace and miscellaneous markup.
##
## Skips whitespace, comments, processing instructions, and `<!...>`
## declarations, stopping at text content or an element open/close tag.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Starting position.
## - `text_len`: Total text length.
##
## ### Returns
## The first significant position.
pub function skip_misc(text: string, pos: int, text_len: int) -> int
    while pos < text_len
        let ch = char_at(text, pos)
        if is_whitespace(ch) == true
            pos += 1
        elif ch == "<"
            if pos + 3 < text_len and substring(text, pos, 4) == "<!--"
                pos = skip_comment(text, pos, text_len)
            elif pos + 1 < text_len and substring(text, pos, 2) == "<?"
                pos = skip_pi(text, pos, text_len)
            elif pos + 1 < text_len and substring(text, pos, 2) == "<!"
                pos = skip_bang(text, pos, text_len)
            else
                break
            end
        else
            break
        end
    end
    return pos
end

## Parses an XML name (`NameStartChar NameChar*`) at the given position.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Starting position.
## - `text_len`: Total text length.
##
## ### Returns
## A `(name, end_pos)` tuple (empty name when no name character follows).
pub function parse_name(text: string, pos: int, text_len: int)
    let start = pos
    while pos < text_len
        if is_name_char(char_at(text, pos)) == true
            pos += 1
        else
            break
        end
    end
    return substring(text, start, pos - start), pos
end

## Parses a hexadecimal digit string into an integer.
##
## Stops at the first non-hex character.
##
## ### Parameters
## - `s`: Hex source string (no `0x` prefix).
##
## ### Returns
## The parsed integer value.
function parse_hex_code(s: string) -> int
    let res = 0
    let i = 0
    let n = len(s)
    while i < n
        let c = ord(char_at(s, i))
        if c >= 48 and c <= 57
            res = res * 16 + (c - 48)
        elif c >= 97 and c <= 102
            res = res * 16 + (c - 97 + 10)
        elif c >= 65 and c <= 70
            res = res * 16 + (c - 65 + 10)
        else
            return res
        end
        i += 1
    end
    return res
end

## Encodes a Unicode codepoint as UTF-8.
##
## chr() only covers 0..255 and crashes the host process above that;
## this helper keeps entity decoding total without touching the compiler.
## Out-of-range codes yield "" (callers fall back to literal passthrough).
function chr_utf8(code: int) -> string
    if code < 0
        return ""
    end
    if code < 128
        return chr(code)
    end
    if code < 2048
        return chr(192 + code / 64) + chr(128 + code % 64)
    end
    if code < 65536
        return chr(224 + code / 4096) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)
    end
    if code < 1114112
        return chr(240 + code / 262144) + chr(128 + (code / 4096) % 64) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)
    end
    return ""
end

## Parses an entity or character reference at the given position.
##
## Handles `&amp;`, `&lt;`, `&gt;`, `&quot;`, `&apos;`, decimal
## (`&#65;`) and hexadecimal (`&#x41;`) references. Unknown entities pass
## through literally; a bare `&` without a terminator yields `"&"`.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `&`.
## - `text_len`: Total text length.
##
## ### Returns
## A `(value, end_pos)` tuple.
pub function parse_entity(text: string, pos: int, text_len: int)
    let i = pos + 1
    let ename = ""
    while i < text_len
        let ch = char_at(text, i)
        if ch == ";"
            break
        end
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" or ch == "<" or ch == "&"
            return "&", pos + 1
        end
        ename += ch
        i += 1
        if len(ename) > 12
            return "&", pos + 1
        end
    end
    if i >= text_len or char_at(text, i) != ";"
        return "&", pos + 1
    end
    let end_pos = i + 1
    if ename == "amp"
        return "&", end_pos
    end
    if ename == "lt"
        return "<", end_pos
    end
    if ename == "gt"
        return ">", end_pos
    end
    if ename == "quot"
        return "\"", end_pos
    end
    if ename == "apos"
        return "'", end_pos
    end
    let elen = len(ename)
    if elen >= 2 and char_at(ename, 0) == "#"
        if char_at(ename, 1) == "x" or char_at(ename, 1) == "X"
            if elen > 2
                let hexpart = substring(ename, 2, elen - 2)
                let hexcode = parse_hex_code(hexpart)
                if hexcode <= 1114111
                    return chr_utf8(hexcode), end_pos
                end
            end
        else
            let digits = substring(ename, 1, elen - 1)
            let di = 0
            let dlen = len(digits)
            let all_digits = true
            while di < dlen
                if is_digit(char_at(digits, di)) == false
                    all_digits = false
                    break
                end
                di += 1
            end
            if all_digits == true and dlen > 0
                let dcode = to_int(digits)
                if dcode <= 1114111
                    return chr_utf8(dcode), end_pos
                end
            end
        end
    end
    return substring(text, pos, end_pos - pos), end_pos
end

## Parses a quoted attribute value with entity decoding.
##
## Tab, LF, and CR normalize to a space per XML 1.0 attribute processing.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of the opening quote (`"` or `'`).
## - `text_len`: Total text length.
##
## ### Returns
## A `(value, end_pos)` tuple.
pub function parse_attr_value(text: string, pos: int, text_len: int)
    let quote = char_at(text, pos)
    pos += 1
    let res = ""
    while pos < text_len
        let ch = char_at(text, pos)
        if ch == quote
            pos += 1
            break
        elif ch == "&"
            let ev, evpos = parse_entity(text, pos, text_len)
            res += ev
            pos = evpos
        elif ch == "\t" or ch == "\n" or ch == "\r"
            res += " "
            pos += 1
        else
            res += ch
            pos += 1
        end
    end
    return res, pos
end

## Parses a `<![CDATA[ ... ]]>` section body.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `<` (the `<![CDATA[` opener must be verified).
## - `text_len`: Total text length.
##
## ### Returns
## A `(content, end_pos)` tuple with the raw (undecoded) content.
pub function parse_cdata(text: string, pos: int, text_len: int)
    pos += 9
    let start = pos
    while pos < text_len
        if pos + 2 < text_len and substring(text, pos, 3) == "]]>"
            return substring(text, start, pos - start), pos + 3
        end
        pos += 1
    end
    return substring(text, start, pos - start), pos
end

## Skips a leading UTF-8 byte-order mark (EF BB BF) if present.
##
## ### Parameters
## - `text`: Source text.
## - `text_len`: Total text length.
##
## ### Returns
## `3` when a BOM leads the input, `0` otherwise.
pub function skip_bom(text: string, text_len: int) -> int
    if text_len >= 3 and ord(char_at(text, 0)) == 239 and ord(char_at(text, 1)) == 187 and ord(char_at(text, 2)) == 191
        return 3
    end
    return 0
end

## Decodes entity and character references inside a plain string.
##
## Applies the same rules as text content: predefined entities,
## decimal and hexadecimal references decode, unknown entities pass
## through literally.
##
## ### Parameters
## - `s`: Source string (null yields `""`).
##
## ### Returns
## The decoded string.
##
## ### Examples
## ```alya
## let t = unescape("a &amp; b") # "a & b"
## ```
pub function unescape(s) -> string
    if s is null
        return ""
    end
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        if char_at(s, i) == "&"
            let ev, evpos = parse_entity(s, i, slen)
            res += ev
            i = evpos
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

## Parses one element (open tag, content, close tag) at the given position.
##
## ### Parameters
## - `text`: Source text.
## - `pos`: Position of `<` opening the element.
## - `text_len`: Total text length.
##
## ### Returns
## A `(node, end_pos)` tuple.
pub function parse_element(text: string, pos: int, text_len: int)
    pos += 1
    pos = skip_ws(text, pos, text_len)
    let ename, epos = parse_name(text, pos, text_len)
    pos = epos
    let attrs = map()
    let order = []
    let self_close = false
    let tag_done = false
    while pos < text_len and tag_done == false
        pos = skip_ws(text, pos, text_len)
        if pos >= text_len
            break
        end
        let tch = char_at(text, pos)
        if tch == ">"
            pos += 1
            tag_done = true
        elif tch == "/"
            if pos + 1 < text_len and char_at(text, pos + 1) == ">"
                pos += 2
                self_close = true
                tag_done = true
            else
                pos += 1
            end
        elif is_name_start_char(tch) == true
            let aname, apos = parse_name(text, pos, text_len)
            pos = skip_ws(text, apos, text_len)
            if pos < text_len and char_at(text, pos) == "="
                pos += 1
                pos = skip_ws(text, pos, text_len)
                if pos < text_len and (char_at(text, pos) == "\"" or char_at(text, pos) == "'")
                    let aval, avpos = parse_attr_value(text, pos, text_len)
                    if _map_has(attrs, aname) == false
                        order.push(aname)
                    end
                    attrs[aname] = aval
                    pos = avpos
                else
                    let bare = ""
                    while pos < text_len
                        let bch = char_at(text, pos)
                        if is_whitespace(bch) == true or bch == ">" or bch == "/"
                            break
                        end
                        bare += bch
                        pos += 1
                    end
                    if _map_has(attrs, aname) == false
                        order.push(aname)
                    end
                    attrs[aname] = bare
                end
            else
                if _map_has(attrs, aname) == false
                    order.push(aname)
                end
                attrs[aname] = ""
            end
        else
            pos += 1
        end
    end
    if self_close == true
        return XmlNode {
            name: ename,
            attrs: attrs,
            children: [],
            text: "",
            attr_order: order
        }, pos
    end
    let children = []
    let buf = ""
    while pos < text_len
        let cch = char_at(text, pos)
        if cch == "<"
            if pos + 1 < text_len and substring(text, pos, 2) == "</"
                let cpos = pos + 2
                cpos = skip_ws(text, cpos, text_len)
                let cname, cpos2 = parse_name(text, cpos, text_len)
                cpos = skip_ws(text, cpos2, text_len)
                if cpos < text_len and char_at(text, cpos) == ">"
                    cpos += 1
                end
                pos = cpos
                break
            elif pos + 3 < text_len and substring(text, pos, 4) == "<!--"
                pos = skip_comment(text, pos, text_len)
            elif pos + 8 < text_len and substring(text, pos, 9) == "<![CDATA["
                let cdata, cdpos = parse_cdata(text, pos, text_len)
                buf += cdata
                pos = cdpos
            elif pos + 1 < text_len and substring(text, pos, 2) == "<?"
                pos = skip_pi(text, pos, text_len)
            elif pos + 1 < text_len and substring(text, pos, 2) == "<!"
                pos = skip_bang(text, pos, text_len)
            else
                let child, chpos = parse_element(text, pos, text_len)
                children.push(child)
                pos = chpos
            end
        elif cch == "&"
            let cev, cevpos = parse_entity(text, pos, text_len)
            buf += cev
            pos = cevpos
        else
            buf += cch
            pos += 1
        end
    end
    return XmlNode {
        name: ename,
        attrs: attrs,
        children: children,
        text: buf,
        attr_order: order
    }, pos
end

## Reads a `name="value"` pair out of a declaration body string.
##
## ### Parameters
## - `body`: Declaration body (e.g. `<?xml version="1.0" ... ?>`).
## - `key`: Attribute key to look up.
## - `fallback`: Value returned when the key is absent.
##
## ### Returns
## The attribute value or the fallback.
function decl_attr(body: string, key: string, fallback: string) -> string
    let blen = len(body)
    let klen = len(key)
    let i = 0
    while i + klen <= blen
        if substring(body, i, klen) == key
            let j = i + klen
            j = skip_ws(body, j, blen)
            if j < blen and char_at(body, j) == "="
                j += 1
                j = skip_ws(body, j, blen)
                if j < blen and (char_at(body, j) == "\"" or char_at(body, j) == "'")
                    let quote = char_at(body, j)
                    j += 1
                    let val = ""
                    while j < blen and char_at(body, j) != quote
                        val += char_at(body, j)
                        j += 1
                    end
                    return val
                end
            end
        end
        i += 1
    end
    return fallback
end

## Parses an XML document string into its root element node.
##
## Skips leading and trailing miscellaneous markup (comments, processing
## instructions, DOCTYPE). Returns null for empty documents.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The root `XmlNode`, or null when no element is present.
##
## ### Examples
## ```alya
## let root = parse_xml("<a><b>x</b></a>")
## ```
pub function parse_xml(text: string)
    let text_len = len(text)
    let pos = skip_misc(text, skip_bom(text, text_len), text_len)
    if pos >= text_len
        return null
    end
    if char_at(text, pos) != "<"
        return null
    end
    if pos + 1 < text_len and substring(text, pos, 2) == "</"
        return null
    end
    let root, _ = parse_element(text, pos, text_len)
    if root is null
        return null
    end
    return root
end

## Parses an XML document string into an `XmlDoc` with declaration metadata.
##
## Reads the `<?xml version="..." encoding="..."?>` prolog when present
## (defaulting to `"1.0"` / `"UTF-8"`) and parses the root element.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The parsed `XmlDoc` instance.
pub function parse_xml_doc(text: string) -> XmlDoc
    let text_len = len(text)
    let pos = skip_ws(text, skip_bom(text, text_len), text_len)
    let version = "1.0"
    let encoding = "UTF-8"
    if pos + 5 < text_len and substring(text, pos, 5) == "<?xml"
        let dch = char_at(text, pos + 5)
        if is_whitespace(dch) == true or dch == "?"
            let q = pos + 5
            while q < text_len
                if q + 1 < text_len and substring(text, q, 2) == "?>"
                    q += 2
                    break
                end
                q += 1
            end
            let decl_body = substring(text, pos, q - pos)
            version = decl_attr(decl_body, "version", "1.0")
            encoding = decl_attr(decl_body, "encoding", "UTF-8")
            pos = q
        end
    end
    pos = skip_misc(text, pos, text_len)
    if pos >= text_len
        return make_doc(null, version, encoding)
    end
    if char_at(text, pos) != "<"
        return make_doc(null, version, encoding)
    end
    if pos + 1 < text_len and substring(text, pos, 2) == "</"
        return make_doc(null, version, encoding)
    end
    let root, rpos = parse_element(text, pos, text_len)
    return make_doc(root, version, encoding)
end

## Validates structural well-formedness, reporting the first violation.
##
## Checks tag balance and names, quoted attribute values, `=` presence,
## and root singularity. Entity strictness (e.g. bare `&`) is outside
## this check and stays lenient by design.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## `""` when well-formed, otherwise a reason with a byte offset
## (e.g. `"mismatched close tag </b> for <a> at byte 6"`).
##
## ### Examples
## ```alya
## let err = check_wellformed("<a><b></a></b>")
## ```
pub function check_wellformed(text: string) -> string
    let text_len = len(text)
    let pos = skip_misc(text, skip_bom(text, text_len), text_len)
    let stack = []
    let saw_root = false
    while pos < text_len
        let ch = char_at(text, pos)
        if ch == "<"
            if pos + 1 < text_len and substring(text, pos, 2) == "</"
                let cpos = pos + 2
                cpos = skip_ws(text, cpos, text_len)
                let cname, cpos2 = parse_name(text, cpos, text_len)
                if len(cname) == 0
                    return f"empty close tag at byte {pos}"
                end
                if is_name_start_char(char_at(cname, 0)) == false
                    return f"invalid close tag name {cname} at byte {pos}"
                end
                cpos = skip_ws(text, cpos2, text_len)
                if cpos < text_len and char_at(text, cpos) == ">"
                    cpos += 1
                else
                    return f"expected > to close </{cname}> at byte {pos}"
                end
                if len(stack) == 0
                    return f"stray close tag </{cname}> at byte {pos}"
                end
                let open = stack.pop()
                if open != cname
                    return f"mismatched close tag </{cname}> for <{open}> at byte {pos}"
                end
                pos = cpos
            elif pos + 3 < text_len and substring(text, pos, 4) == "<!--"
                pos = skip_comment(text, pos, text_len)
            elif pos + 1 < text_len and substring(text, pos, 2) == "<?"
                pos = skip_pi(text, pos, text_len)
            elif pos + 1 < text_len and substring(text, pos, 2) == "<!"
                pos = skip_bang(text, pos, text_len)
            else
                let tag_start = pos
                let opos = pos + 1
                opos = skip_ws(text, opos, text_len)
                let oname, opos2 = parse_name(text, opos, text_len)
                if len(oname) == 0
                    return f"expected element name at byte {pos}"
                end
                if is_name_start_char(char_at(oname, 0)) == false
                    return f"invalid element name {oname} at byte {pos}"
                end
                pos = opos2
                let self_close = false
                let tag_done = false
                let wferr = ""
                while pos < text_len and tag_done == false
                    pos = skip_ws(text, pos, text_len)
                    if pos >= text_len
                        break
                    end
                    let tch = char_at(text, pos)
                    if tch == ">"
                        pos += 1
                        tag_done = true
                    elif tch == "/"
                        if pos + 1 < text_len and char_at(text, pos + 1) == ">"
                            pos += 2
                            self_close = true
                            tag_done = true
                        else
                            wferr = f"expected > after / at byte {pos}"
                            tag_done = true
                        end
                    elif is_name_start_char(tch) == true
                        let aname, apos = parse_name(text, pos, text_len)
                        pos = skip_ws(text, apos, text_len)
                        if pos < text_len and char_at(text, pos) == "="
                            pos += 1
                            pos = skip_ws(text, pos, text_len)
                            if pos < text_len and (char_at(text, pos) == "\"" or char_at(text, pos) == "'")
                                let _, avpos = parse_attr_value(text, pos, text_len)
                                pos = avpos
                            else
                                wferr = f"unquoted attribute value for {aname} at byte {pos}"
                                tag_done = true
                            end
                        else
                            wferr = f"expected = after attribute {aname} at byte {pos}"
                            tag_done = true
                        end
                    else
                        wferr = f"unexpected character {tch} in tag <{oname}> at byte {pos}"
                        tag_done = true
                    end
                end
                if wferr != ""
                    return wferr
                end
                if tag_done == false
                    return f"unterminated tag <{oname}> at byte {pos}"
                end
                if len(stack) == 0
                    if saw_root == true
                        return f"multiple root elements at byte {tag_start}"
                    end
                    saw_root = true
                end
                if self_close == false
                    stack.push(oname)
                end
            end
        else
            let tstart = pos
            while pos < text_len and char_at(text, pos) != "<"
                pos += 1
            end
            let seg = substring(text, tstart, pos - tstart)
            let si = 0
            let seglen = len(seg)
            let has_text = false
            while si < seglen
                if is_whitespace(char_at(seg, si)) == false
                    has_text = true
                    break
                end
                si += 1
            end
            if has_text == true and len(stack) == 0
                return f"character content outside root element at byte {tstart}"
            end
        end
    end
    if len(stack) > 0
        let open = stack.pop()
        return f"unclosed <{open}> at end of input (byte {text_len})"
    end
    if saw_root == false
        return "no root element"
    end
    return ""
end
