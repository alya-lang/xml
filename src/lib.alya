## # xml
##
## A zero-dependency XML 1.0 parser and serializer for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./parser.alya"
import "./serializer.alya"

# ───────────────────────────────────────────────────────────────
# 1. Parsing APIs
# ───────────────────────────────────────────────────────────────

## Parses an XML string into its root element node.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The root `XmlNode`, or null when no element is present.
##
## ### Examples
## ```alya
## let root = parse("<server host=\"127.0.0.1\"/>")
## ```
pub function parse(text: string)
    return parse_xml(text)
end

## Parses an XML string into an `XmlDoc` with declaration metadata.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The parsed `XmlDoc` instance.
pub function parse_doc(text: string) -> XmlDoc
    return parse_xml_doc(text)
end

## Reads an XML file from disk and parses it into a root node.
##
## Requires the `io` feature (default-on).
##
## ### Parameters
## - `path`: File path string.
##
## ### Returns
## The root `XmlNode`.
@cfg(feature = "io")
pub function load_file(path: string)
    let content = read_file(path)
    return parse_xml(content)
end

## Reads an XML file from disk into an `XmlDoc` struct.
##
## ### Parameters
## - `path`: File path string.
##
## ### Returns
## The parsed `XmlDoc` instance.
@cfg(feature = "io")
pub function load_doc(path: string) -> XmlDoc
    let content = read_file(path)
    return parse_xml_doc(content)
end

## Checks whether a string holds a well-formed XML document.
##
## ### Parameters
## - `text`: Candidate XML string.
##
## ### Returns
## `1` when an element parses, `0` otherwise.
pub function is_valid(text: string) -> int
    return parse_xml(text) is not null
end

## Parses an XML string, returning null unless it is well-formed.
##
## Structural gate first (`check_wellformed`): mismatched tags, unquoted
## attributes, and multiple roots yield null instead of lenient output.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The root `XmlNode`, or null when validation fails.
pub function parse_strict(text: string)
    if check_wellformed(text) != ""
        return null
    end
    return parse_xml(text)
end

## Parses an XML string into an `XmlDoc`, returning an empty document
## unless the input is well-formed.
##
## ### Parameters
## - `text`: XML document string.
##
## ### Returns
## The parsed `XmlDoc`, or an empty document on validation failure.
pub function parse_doc_strict(text: string) -> XmlDoc
    if check_wellformed(text) != ""
        return make_doc(null, "1.0", "UTF-8")
    end
    return parse_xml_doc(text)
end

# ───────────────────────────────────────────────────────────────
# 2. Accessor Helpers
# ───────────────────────────────────────────────────────────────

## Returns an attribute value or a default when missing.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
## - `key`: Attribute name string.
## - `default_val`: Fallback string. Defaults to `""`.
##
## ### Returns
## The attribute value or the default.
pub function get_attr(node, key: string, default_val: string = "") -> string
    if node is null or node.attrs is null
        return default_val
    end
    if key in node.attrs
        return node.attrs[key]
    end
    return default_val
end

## Checks whether a node carries an attribute.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
## - `key`: Attribute name string.
##
## ### Returns
## `1` when present, `0` otherwise.
pub function has_attr(node, key: string) -> int
    if node is null or node.attrs is null
        return 0
    end
    return key in node.attrs ? 1 : 0
end

## Returns the child element array (empty when none).
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
##
## ### Returns
## The child element array.
pub function children(node) -> array
    if node is null or node.children is null
        return []
    end
    return node.children
end

## Counts direct child elements.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
##
## ### Returns
## The child element count.
pub function child_count(node) -> int
    if node is null or node.children is null
        return 0
    end
    return len(node.children)
end

## Collects direct children with a given tag name.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
## - `name`: Tag name string.
##
## ### Returns
## The matching child element array.
pub function children_by_name(node, name: string) -> array
    let res = []
    if node is null or node.children is null
        return res
    end
    for kid in node.children
        if kid.name == name
            res.push(kid)
        end
    end
    return res
end

## Returns the first direct child with a given tag name.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
## - `name`: Tag name string.
##
## ### Returns
## The first matching child, or null when absent.
pub function first_child(node, name: string)
    if node is null or node.children is null
        return null
    end
    # NOTE: do not `return kid` directly here: returning an array element
    # from inside a loop yields a stale pointer, so collect then return.
    let found = null
    for kid in node.children
        if kid.name == name
            found = kid
            break
        end
    end
    return found
end

## Returns node text content or a default when empty.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
## - `default_val`: Fallback string. Defaults to `""`.
##
## ### Returns
## The text content or the default.
pub function text_of(node, default_val: string = "") -> string
    if node is null or node.text is null or node.text == ""
        return default_val
    end
    return node.text
end

## Resolves a dot-separated element path (e.g. `"catalog.book.title"`).
##
## Each segment descends into the first matching child element.
##
## ### Parameters
## - `node`: Starting `XmlNode` (or null).
## - `path_str`: Dot-separated path string (or null).
##
## ### Returns
## The resolved node, or null when any segment is missing.
pub function find_path(node, path_str: string)
    if node is null or path_str is null
        return null
    end
    let plen = len(path_str)
    let cur = node
    let seg = ""
    let i = 0
    while i <= plen
        let ch = ""
        if i < plen
            ch = char_at(path_str, i)
        end
        if ch == "." or i == plen
            if len(seg) > 0
                cur = first_child(cur, seg)
                if cur is null
                    return null
                end
                seg = ""
            end
        else
            seg += ch
        end
        i += 1
    end
    return cur
end

## Recursively collects every descendant (including self) with a tag name.
##
## ### Parameters
## - `node`: Starting `XmlNode` (or null).
## - `name`: Tag name string.
##
## ### Returns
## The matching node array in document order.
pub function find_all(node, name: string) -> array
    let res = []
    if node is null
        return res
    end
    if node.name == name
        res.push(node)
    end
    if node.children is not null
        for kid in node.children
            let sub = find_all(kid, name)
            for item in sub
                res.push(item)
            end
        end
    end
    return res
end

## Returns trimmed text at an element path, or a default when missing.
##
## ### Parameters
## - `node`: Starting `XmlNode` (or null).
## - `path_str`: Dot-separated path string.
## - `default_val`: Fallback string. Defaults to `""`.
##
## ### Returns
## The trimmed text or the default.
pub function text_at(node, path_str: string, default_val: string = "") -> string
    let target = find_path(node, path_str)
    if target is null
        return default_val
    end
    return trim(target.text)
end

# ───────────────────────────────────────────────────────────────
# 2b. Namespace Helpers
# ───────────────────────────────────────────────────────────────

## Returns the local part of a qualified tag name.
##
## ### Parameters
## - `qname`: Qualified name string (or null).
##
## ### Returns
## The substring after the first `:`, or the whole name when unprefixed.
pub function local_name(qname: string) -> string
    if qname is null
        return ""
    end
    let n = len(qname)
    let i = 0
    while i < n
        if char_at(qname, i) == ":"
            return substring(qname, i + 1, n - i - 1)
        end
        i += 1
    end
    return qname
end

## Returns the namespace prefix of a qualified tag name.
##
## ### Parameters
## - `qname`: Qualified name string (or null).
##
## ### Returns
## The substring before the first `:`, or `""` when unprefixed.
pub function ns_prefix(qname: string) -> string
    if qname is null
        return ""
    end
    let n = len(qname)
    let i = 0
    while i < n
        if char_at(qname, i) == ":"
            return substring(qname, 0, i)
        end
        i += 1
    end
    return ""
end

## Collects namespace declarations (`xmlns`) on a single node.
##
## ### Parameters
## - `node`: Target `XmlNode` (or null).
##
## ### Returns
## A prefix-to-URI map; the default namespace (if any) sits under `""`.
pub function ns_scope(node) -> map
    let scope = map()
    if node is null or node.attrs is null
        return scope
    end
    let names = keys(node.attrs)
    for aname in names
        if aname == "xmlns"
            scope[""] = node.attrs[aname]
        elif len(aname) > 6 and substring(aname, 0, 6) == "xmlns:"
            scope[substring(aname, 6, len(aname) - 6)] = node.attrs[aname]
        end
    end
    return scope
end

## Recursively collects descendants matching a namespace URI and local name.
##
## Scope is inherited down the tree (inner `xmlns` wins); unprefixed
## names resolve against the in-scope default namespace. Elements only —
## attributes are never namespace-matched.
##
## ### Parameters
## - `node`: Starting `XmlNode` (or null).
## - `uri`: Namespace URI string ("" for no namespace).
## - `local`: Local tag name string.
##
## ### Returns
## The matching node array in document order.
pub function find_ns(node, uri: string, local: string) -> array
    return find_ns_scoped(node, uri, local, map())
end

## Scoped worker for `find_ns` carrying the inherited declarations.
##
## ### Parameters
## - `node`: Current `XmlNode` (or null).
## - `uri`: Namespace URI string.
## - `local`: Local tag name string.
## - `scope`: Inherited prefix-to-URI map.
##
## ### Returns
## The matching node array in document order.
function find_ns_scoped(node, uri: string, local: string, scope) -> array
    let res = []
    if node is null
        return res
    end
    let merged = map()
    let skeys = keys(scope)
    for sk in skeys
        merged[sk] = scope[sk]
    end
    let decls = ns_scope(node)
    let dkeys = keys(decls)
    for dk in dkeys
        merged[dk] = decls[dk]
    end
    let pfx = ns_prefix(node.name)
    let node_uri = ""
    if pfx == ""
        if _map_has(merged, "") == 1
            node_uri = merged[""]
        end
    else
        if _map_has(merged, pfx) == 1
            node_uri = merged[pfx]
        end
    end
    if node_uri == uri and local_name(node.name) == local
        res.push(node)
    end
    if node.children is not null
        for kid in node.children
            let sub = find_ns_scoped(kid, uri, local, merged)
            for item in sub
                res.push(item)
            end
        end
    end
    return res
end

# ───────────────────────────────────────────────────────────────
# XmlDoc Struct Methods
# ───────────────────────────────────────────────────────────────

## Resolves a dot-separated element path from the document root.
##
## ### Parameters
## - `self`: The target `XmlDoc` instance.
## - `path_str`: Dot-separated path string.
##
## ### Returns
## The resolved node, or null when any segment is missing.
pub function XmlDoc.find(self: XmlDoc, path_str: string)
    return find_path(self.root, path_str)
end

## Recursively collects descendants with a tag name from the root.
##
## ### Parameters
## - `self`: The target `XmlDoc` instance.
## - `name`: Tag name string.
##
## ### Returns
## The matching node array in document order.
pub function XmlDoc.find_all(self: XmlDoc, name: string) -> array
    return find_all(self.root, name)
end

## Returns trimmed text at an element path from the root.
##
## ### Parameters
## - `self`: The target `XmlDoc` instance.
## - `path_str`: Dot-separated path string.
## - `default_val`: Fallback string. Defaults to `""`.
##
## ### Returns
## The trimmed text or the default.
pub function XmlDoc.text_at(self: XmlDoc, path_str: string, default_val: string = "") -> string
    return text_at(self.root, path_str, default_val)
end

## Serializes this document (declaration plus root) to an XML string.
##
## ### Parameters
## - `self`: The target `XmlDoc` instance.
## - `pretty`: `1` for indented output, `0` for compact output. Defaults to `0`.
##
## ### Returns
## The XML document string.
pub function XmlDoc.to_string(self: XmlDoc, pretty: int = 0) -> string
    return doc_to_string(self, pretty)
end

# ───────────────────────────────────────────────────────────────
# 3. Serialization APIs
# ───────────────────────────────────────────────────────────────

## Serializes a node tree to an XML string.
##
## ### Parameters
## - `node`: Root `XmlNode`.
## - `pretty`: `1` for indented output, `0` for compact output. Defaults to `0`.
##
## ### Returns
## The XML document string.
pub function stringify(node, pretty: int = 0) -> string
    return node_to_string(node, pretty)
end

## Serializes a document (declaration plus root) to an XML string.
##
## ### Parameters
## - `doc`: Target `XmlDoc`.
## - `pretty`: `1` for indented output, `0` for compact output. Defaults to `0`.
##
## ### Returns
## The XML document string.
pub function stringify_doc(doc: XmlDoc, pretty: int = 0) -> string
    return doc_to_string(doc, pretty)
end

## Writes an XML string directly to a file.
##
## Requires the `io` feature (default-on).
##
## ### Parameters
## - `path`: File path string.
## - `xml_str`: XML document string.
@cfg(feature = "io")
pub function dump_file(path: string, xml_str: string)
    return write_file(path, xml_str)
end
