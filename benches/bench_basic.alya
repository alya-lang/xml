## Benchmark suite for the xml package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as xml

function main()
    let runner = bench_runner("Alya XML Package Micro-Benchmarks")

    let sample_xml = "
<inventory region=\"eu-central\">
    <service id=\"api-1\" tls=\"true\">
        <name>gateway</name>
        <host>127.0.0.1</host>
        <port>8080</port>
    </service>
    <service id=\"api-2\" tls=\"false\">
        <name>worker</name>
        <host>127.0.0.2</host>
        <port>9000</port>
    </service>
</inventory>
"

    # 1. Parse Benchmark (10,000 iterations)
    bench_start(runner, 10000)
    let i = 0
    while i < 10000
        let root = xml::parse(sample_xml)
        i += 1
    end
    bench_stop(runner, "xml::parse() 10,000 iterations")

    # 2. Path Access Benchmark (50,000 lookups)
    let parsed = xml::parse(sample_xml)
    bench_start(runner, 50000)
    let j = 0
    while j < 50000
        let region = xml::get_attr(parsed, "region")
        let first_name = xml::text_at(parsed, "service.name")
        let first_port = xml::text_at(parsed, "service.port")
        j += 1
    end
    bench_stop(runner, "xml::get_attr() & text_at() 50,000 lookups")

    # 3. Serialization Benchmark (20,000 iterations)
    bench_start(runner, 20000)
    let k = 0
    while k < 20000
        let node = xml::make_element("server")
        xml::set_attr(node, "host", "localhost")
        let name_node = xml::set_text(xml::make_element("name"), "edge")
        xml::add_child(node, name_node)
        let out = xml::stringify(node)
        k += 1
    end
    bench_stop(runner, "builder + stringify() 20,000 iterations")

    bench_summary(runner)
end

main()
