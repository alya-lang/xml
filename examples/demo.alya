## Demo of the xml library
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as xml

function main()
    say "=== Alya XML Library Demo ==="
    say ""

    # 1. Sample service inventory document
    let sample_xml = "
<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!-- Production service inventory -->
<inventory region=\"eu-central\">
    <service id=\"api-1\" tls=\"true\">
        <name>gateway</name>
        <host>127.0.0.1</host>
        <port>8080</port>
        <note><![CDATA[Handles <all> public traffic & retries]]></note>
    </service>
    <service id=\"api-2\" tls=\"false\">
        <name>worker</name>
        <host>127.0.0.2</host>
        <port>9000</port>
        <note>Background jobs</note>
    </service>
</inventory>
"

    # 2. Parse XML string with declaration metadata
    say "1. Parsing document..."
    let doc = xml::parse_doc(sample_xml)
    say "✓ Parsed as XML {doc.version} ({doc.encoding})"
    say ""

    # 3. Attribute and path queries
    say "2. Inspecting inventory:"
    let region = xml::get_attr(doc.root, "region")
    let first_name = doc.text_at("service.name")
    let first_port = doc.text_at("service.port")
    say "  • Region: {region}"
    say "  • First service: {first_name}:{first_port}"
    say ""

    # 4. Iterating repeated elements
    say "3. Iterating services:"
    let services = doc.find_all("service")
    let i = 0
    while i < len(services)
        let svc = services[i]
        let sid = xml::get_attr(svc, "id")
        let sname = xml::text_at_path(svc, "name")
        let sport = xml::text_at_path(svc, "port")
        let stls = xml::get_attr(svc, "tls", "false")
        let tls_label = "plain"
        if stls == "true"
            tls_label = "TLS"
        end
        say "  • [{tls_label}] {sid}: {sname} on port {sport}"
        i += 1
    end
    say ""

    # 5. CDATA content arrives decoded
    say "4. Reading CDATA note:"
    let note = doc.text_at("service.note")
    say "  • Note: {note}"
    say ""

    # 6. Programmatic document builder
    say "5. Building XML programmatically:"
    let root = xml::make_element("server")
    xml::set_attr(root, "host", "0.0.0.0")
    let name_node = xml::set_text(xml::make_element("name"), "edge")
    xml::add_child(root, name_node)
    xml::add_child(root, xml::make_element("tls"))
    let out_xml = xml::stringify(root, 1)
    say "----------------------------------------"
    say out_xml
    say "----------------------------------------"

    # 7. Round-trip back through the parser
    let back = xml::parse(out_xml)
    let back_host = xml::get_attr(back, "host")
    say "  • Round-trip host: {back_host}"
    say "✓ Demo completed successfully!"
end

main()
